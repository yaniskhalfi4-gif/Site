<script>
(function(){
  // toute la carte de pack renvoie vers la page produit, avec l'offre présélectionnée
  document.querySelectorAll('.pack').forEach(function(card){
    var link = card.querySelector('a[href]');
    if (!link) return;
    card.addEventListener('click', function(e){
      if (e.target.closest('a')) return;   // le lien gère déjà son propre clic
      window.location.href = link.getAttribute('href');
    });
  });
})();
</script>



