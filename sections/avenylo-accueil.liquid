/* --- cadrage des photos : avis et sécurité ---
   La photo n'est plus rognée : elle est affichée en entier (l'appareil compris).
   L'espace restant est comblé par un halo flouté tiré de la photo elle-même. */
.ph-fill{position:relative;overflow:hidden;margin:0;display:block;
  background:linear-gradient(150deg,#F3F1FD,#E6E2FA)}
.ph-fill::before{content:"";position:absolute;inset:0;
  background-image:var(--ph);background-size:cover;background-position:center;
  transform:scale(1.28);filter:blur(30px) saturate(1.18) brightness(1.05);opacity:.82}
.ph-fill::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(120% 88% at 50% 38%,transparent 42%,rgba(23,19,52,.16) 100%)}
.ph-fill img{position:relative;z-index:2;width:100%;height:100%;
  object-fit:contain;object-position:center;display:block;
  min-height:0;max-height:none;aspect-ratio:auto}

/* cartes d'avis : la photo passe en haut, pleine largeur.
   Le texte récupère toute la largeur de la carte : cartes plus courtes,
   photos plus grandes, lecture bien plus facile. */
.rv{display:flex!important;flex-direction:column;overflow:hidden;
  transition:transform .28s ease,box-shadow .28s ease,border-color .28s ease}
.rv:hover{transform:translateY(-4px);border-color:#D8D3F2;
  box-shadow:0 30px 56px -40px rgba(11,8,30,.9)}
.rv.photo{grid-template-columns:1fr!important}
.rv-ph{width:100%;aspect-ratio:16/10;border-bottom:1px solid var(--line)}
.rv-body{padding:22px 26px 24px;background:#fff;position:relative;z-index:1;
  display:flex;flex-direction:column;flex:1}
.rv h3{line-height:1.3;margin-bottom:8px}
.rv p{line-height:1.6}
.rv footer{margin-top:auto;padding-top:16px;display:flex;align-items:center;gap:8px}
.rv footer::before{content:"";width:26px;height:26px;border-radius:50%;flex:0 0 26px;
  background:linear-gradient(150deg,var(--halo),var(--violet));opacity:.85}

/* photo de la section sécurité */
.safe2-ph{height:100%;min-height:460px}
.split-img{object-fit:cover;object-position:center center}

@media(max-width:900px){
  .rv-ph{aspect-ratio:4/3}
  .safe2-ph{height:auto;min-height:0;aspect-ratio:4/3}
