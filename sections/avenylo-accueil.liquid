{%- comment -%} Avenylo — Avenylo accueil {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>

:root{
  --ink:#171334;--ink-soft:#3B3660;--violet:#6B62CE;--violet-deep:#4A41A8;
  --halo:#C9C4F5;--paper:#FBFAFE;--line:#E6E3F5;--grey:#6E6B85;
  --green:#00A36C;
  --radius:18px;--max:1180px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Instrument Sans",system-ui,sans-serif;font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:var(--max);margin:0 auto;padding:0 22px}
h1,h2,h3,.wordmark{font-family:"Poppins",sans-serif;font-weight:600;text-transform:lowercase;letter-spacing:-.035em;line-height:1.06;margin:0}
h1{font-size:clamp(2.3rem,5.4vw,3.8rem)}
h2{font-size:clamp(1.85rem,3.8vw,2.8rem)}
h3{font-size:1.15rem;letter-spacing:-.02em}
p{margin:0}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--violet);margin-bottom:16px}
.lead{color:var(--grey);font-size:1.05rem;max-width:56ch}
:focus-visible{outline:2.5px solid var(--violet);outline-offset:3px;border-radius:6px}

/* ---------- EMPLACEMENTS PHOTO ---------- */
.ph{position:relative;background:linear-gradient(135deg,#EFEDFB,#DEDAF6);border-radius:var(--radius);
  display:grid;place-items:center;text-align:center;padding:20px;overflow:hidden}
.ph::before{content:"";position:absolute;inset:10px;border:1.5px dashed rgba(107,98,206,.45);border-radius:12px}
.ph span{position:relative;font-family:"IBM Plex Mono",monospace;font-size:.7rem;letter-spacing:.08em;
  color:var(--violet-deep);max-width:24ch;line-height:1.5;text-transform:uppercase}

.topbar{background:var(--ink);color:#fff;font-size:.8rem;text-align:center;padding:9px 16px}
.topbar span{opacity:.55;margin:0 10px}
/* ---------- panier ---------- */
.cart{position:relative;display:inline-grid;place-items:center;width:44px;height:44px;border-radius:12px;
  color:var(--ink);text-decoration:none;transition:background .15s}
.cart:hover{background:rgba(107,98,206,.09);color:var(--violet)}
.cart svg{width:24px;height:24px;display:block}
.cart .count{position:absolute;top:2px;right:2px;background:var(--ink);color:#fff;min-width:18px;height:18px;
  border-radius:50%;font-size:.65rem;font-weight:700;display:grid;place-items:center;padding:0 4px;border:2px solid var(--paper)}
header{position:sticky;top:0;z-index:60;background:rgba(251,250,254,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.wordmark{font-size:1.5rem;letter-spacing:-.055em;color:var(--violet);text-decoration:none;text-shadow:0 1.5px 0 rgba(74,65,168,.35)}
.nav-links{display:flex;gap:28px;font-size:.93rem;color:var(--ink-soft)}
.nav-links a{text-decoration:none}
.nav-links a:hover{color:var(--violet)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--violet);color:#fff;text-decoration:none;font-weight:600;font-size:.97rem;padding:16px 28px;border-radius:100px;border:0;cursor:pointer;box-shadow:0 6px 18px -6px rgba(107,98,206,.65);transition:transform .15s,background .15s;font-family:inherit}
.btn:hover{background:var(--violet-deep);transform:translateY(-1px)}
.btn--sm{padding:11px 20px;font-size:.9rem}
.btn--light{background:#fff;color:var(--ink);box-shadow:0 6px 18px -8px rgba(23,19,52,.35)}
.btn--light:hover{background:var(--halo);color:var(--ink)}
.btn--ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.5);box-shadow:none}
.btn--ghost:hover{background:rgba(255,255,255,.14)}
@media(max-width:880px){.nav-links{display:none}}

/* ============ A — ATTENTION : photo + accroche collée à gauche ============ */
.hero{position:relative;width:100%;margin:0;overflow:hidden;background:#EFEDFB}
/* pleine largeur, pleine hauteur du bandeau */
.hero-img{display:block;width:100%;height:min(72vh,680px);object-fit:cover;object-position:center 46%}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:120px;z-index:2;pointer-events:none;
  background:linear-gradient(180deg,rgba(11,8,30,0),rgba(11,8,30,.55) 55%,rgba(11,8,30,.92))}
.hero-overlay{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-start;
  padding:0 0 50px 0;
  background:linear-gradient(90deg,rgba(11,8,30,.90) 0%,rgba(11,8,30,.74) 18%,rgba(11,8,30,.34) 32%,rgba(11,8,30,0) 46%)}
.hero-txt{width:min(40%,400px);margin-left:clamp(20px,3vw,48px)}
.hero-overlay .eyebrow{color:var(--halo);margin-bottom:12px}
.hero h1{color:#fff;font-size:clamp(1.9rem,3.4vw,3rem);text-shadow:0 2px 22px rgba(11,8,30,.6)}
.hero h1 em{font-style:normal;color:var(--halo)}
.hero-sub{color:rgba(255,255,255,.92);font-size:1rem;margin-top:14px;text-shadow:0 1px 14px rgba(11,8,30,.7)}
.hero-cta{display:flex;gap:10px;margin-top:26px;flex-wrap:wrap}
.hero-trust{display:flex;flex-direction:column;gap:6px;margin-top:22px;font-size:.84rem;color:rgba(255,255,255,.85);text-shadow:0 1px 10px rgba(11,8,30,.7)}
.hero-trust i{color:var(--halo);font-style:normal;margin-right:7px}
.btn--outline{background:#fff;color:var(--ink);border:1.5px solid var(--line);box-shadow:none}
.btn--outline:hover{background:#fff;color:var(--violet);border-color:var(--halo)}
@media(max-width:900px){
  .hero-img{height:min(52vh,380px);object-fit:cover;object-position:70% 48%}
  .hero-overlay{position:static;background:var(--ink);padding:32px 22px 38px;display:block}
  .hero-txt{width:auto;margin-left:0}
  .hero-trust{flex-direction:row;flex-wrap:wrap;gap:8px 22px}
}


/* ---------- timeline "à quoi s'attendre" ---------- */
.tl{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.tl-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
  display:flex;flex-direction:column}
.tl-media{position:relative}
.tl-media img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.tl-num{position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:50%;background:var(--violet);
  color:#fff;display:grid;place-items:center;font-family:"IBM Plex Mono",monospace;font-size:.78rem;
  box-shadow:0 4px 12px -4px rgba(11,8,30,.6)}
.tl-body{padding:20px 22px 24px}
.tl-day{display:block;font-family:"IBM Plex Mono",monospace;font-size:.74rem;letter-spacing:.12em;
  text-transform:uppercase;color:var(--violet);margin-bottom:6px}
.tl-body h3{margin-bottom:8px}
.tl-body p{color:var(--grey);font-size:.92rem}
.tl-note{margin:26px auto 0;max-width:70ch;text-align:center;font-size:.86rem;color:var(--grey)}
@media(max-width:1000px){.tl{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.tl{grid-template-columns:1fr}}
.split-img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);display:block}


/* ---------- sécurité ---------- */
.safety{background:var(--ink);color:#fff;border-radius:26px;padding:50px 44px}
.safety h2{color:#fff}.safety .lead{color:rgba(255,255,255,.62)}.safety .eyebrow{color:var(--halo)}
.safety-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}
.safety-item{border-top:2px solid rgba(201,196,245,.45);padding-top:20px}
.safety-item .ico{font-size:1.7rem;display:block;margin-bottom:12px}
.safety-item h3{color:#fff;margin-bottom:6px}
.safety-item p{color:rgba(255,255,255,.6);font-size:.92rem}
.safety-item.warn{border-top-color:#E9B44C}
@media(max-width:860px){.safety{padding:34px 24px}.safety-grid{grid-template-columns:1fr}}

/* ---------- packs ---------- */
.packs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.pack{position:relative;background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);padding:30px 26px;text-align:center;
  display:flex;flex-direction:column;transition:border-color .15s,transform .15s}
.pack:hover{border-color:var(--halo);transform:translateY(-2px)}
.pack.best{border-color:var(--violet);box-shadow:0 18px 40px -30px rgba(107,98,206,.9)}
.pack .flag{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
  font-family:"IBM Plex Mono",monospace;font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;padding:5px 14px;border-radius:100px}
.pack h3{font-size:1.3rem;margin-bottom:6px}
.pack .p-sub{color:var(--grey);font-size:.9rem;min-height:42px}
.pack .p-price{font-family:"Poppins",sans-serif;font-weight:600;font-size:2.1rem;letter-spacing:-.04em;margin:16px 0 2px}
.pack .p-strike{color:var(--grey);text-decoration:line-through;font-size:.92rem}
.pack .p-unit{color:var(--violet);font-size:.85rem;margin-top:8px;font-weight:600}
.pack .btn{margin-top:22px;width:100%}
@media(max-width:860px){.packs{grid-template-columns:1fr}}

/* ---------- packshot en filigrane dans les packs ---------- */
.pack{overflow:hidden}
.pack::before{content:"";position:absolute;right:-30%;bottom:-20%;width:84%;aspect-ratio:1/1;
  z-index:0;pointer-events:none;opacity:.5;mix-blend-mode:multiply;
  background:url({{ 'avenylo-7faca4eb.jpg' | asset_url }}) no-repeat center/contain}
.pack > *{position:relative;z-index:1}
/* toute la carte est cliquable */
.pack{cursor:pointer}
.pack .btn:hover{transform:none}
.pack:hover::before{opacity:.62}
.p-qty-unused{position:absolute;top:10px;right:10px;background:rgba(255,255,255,.94);color:var(--ink);
  font-family:"Poppins",sans-serif;font-weight:600;font-size:.8rem;letter-spacing:-.02em;
  padding:5px 11px;border-radius:100px;box-shadow:0 6px 18px -10px rgba(11,8,30,.7)}

/* ---------- en-tête d'avis ---------- */
.rv-hero{display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap;
  background:linear-gradient(120deg,var(--ink) 0%,#241E52 55%,var(--violet-deep) 100%);
  color:#fff;border-radius:var(--radius);padding:30px 34px;margin-bottom:24px}
.rv-hero .eyebrow{color:var(--halo);margin-bottom:8px}
.rv-hero h2{color:#fff;font-size:clamp(1.6rem,2.8vw,2.15rem);margin:0}
.rv-hero-score{text-align:right;flex-shrink:0}
.rv-hero-score .gstars{margin-bottom:8px}
.rv-hero-num{font-family:"Poppins",sans-serif;font-weight:600;font-size:2.3rem;letter-spacing:-.04em;line-height:1}
.rv-hero-num span{font-size:1.1rem;color:rgba(255,255,255,.5);margin-left:2px}
.rv-hero-sub{font-size:.84rem;color:rgba(255,255,255,.62);margin-top:6px}
@media(max-width:700px){.rv-hero{padding:24px;justify-content:flex-start}.rv-hero-score{text-align:left}}


/* ---------- sécurité (clair, dans le thème) ---------- */
.safe2{display:grid;grid-template-columns:1fr 1fr;gap:0;background:linear-gradient(140deg,#F3F1FD,#E6E2FA);
  border:1px solid var(--line);border-radius:26px;overflow:hidden}
.safe2-ph{min-height:460px}
.safe2-txt{padding:48px 44px}
.safe2 h2{margin-bottom:16px}
.safe2 .lead{color:var(--ink-soft)}
.safe-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}
.safe-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 16px 18px}
.safe-card .dot{width:22px;height:22px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;
  font-size:.72rem;margin-bottom:10px}
.safe-card.warn .dot{background:#E9A93C}
.safe-card h3{font-size:.98rem;margin-bottom:4px}
.safe-card p{font-size:.82rem;color:var(--grey)}
@media(max-width:900px){.safe2{grid-template-columns:1fr}.safe2-ph{min-height:0;aspect-ratio:4/3}.safe2-txt{padding:32px 24px}
  .safe-cards{grid-template-columns:1fr}}

/* ---------- bandeau garantie sur fond d'ondes ---------- */
.wave{position:relative;border-radius:26px;overflow:hidden;text-align:center}
.wave img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.wave-tint{position:absolute;inset:0;background:linear-gradient(180deg,rgba(74,65,168,.55),rgba(43,36,110,.75))}
.wave-in{position:relative;padding:86px 26px}
.wave h2{color:#fff;max-width:18ch;margin:0 auto 18px}
.wave p{color:rgba(255,255,255,.82);max-width:52ch;margin:0 auto 30px}
.wave .btn{background:#fff;color:var(--violet-deep)}
.wave .btn:hover{background:var(--halo);color:var(--ink)}
.wave small{display:block;margin-top:20px;color:rgba(255,255,255,.7);font-size:.85rem}
@media(max-width:700px){.wave-in{padding:56px 20px}}

/* ---------- avis façon plateforme ---------- */
.rv-top{text-align:center;margin-bottom:30px}
.rv-score{display:inline-flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center}
.rv-score b{font-family:"Poppins",sans-serif;font-size:1.6rem;letter-spacing:-.03em}
.rv-score small{color:var(--grey);font-size:.9rem}
.rv-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.rv{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:grid}
.rv.photo{grid-template-columns:minmax(0,300px) 1fr}
.rv-body{padding:24px 26px}
.rv-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}
.rv h3{font-size:1.02rem;margin-bottom:8px}
.rv p{font-size:.93rem;color:var(--ink-soft)}
.rv footer{margin-top:14px;font-size:.83rem;color:var(--grey)}
.verif{color:var(--green);font-weight:600;font-size:.82rem;white-space:nowrap}
@media(max-width:900px){.rv-grid{grid-template-columns:1fr}}
@media(max-width:520px){.rv.photo{grid-template-columns:1fr}}


/* ---------- étoiles façon plateforme d'avis ---------- */
.gstars{display:inline-flex;gap:3px;line-height:1}
.gstars i{width:21px;height:21px;border-radius:2px;background:var(--green);color:#fff;font-style:normal;
  font-size:.74rem;display:grid;place-items:center}
.gstars i.off{background:#DDDCE6}
.gstars i.half{background:linear-gradient(90deg,var(--green) 50%,#DDDCE6 50%)}
.gstars.sm i{width:17px;height:17px;font-size:.62rem}

/* ---------- pastille ventes ---------- */
.sold{position:absolute;top:18px;left:clamp(20px,3vw,48px);z-index:3;display:inline-flex;align-items:center;gap:10px;
  background:#fff;border-radius:100px;padding:9px 14px 9px 16px;font-size:.86rem;
  box-shadow:0 10px 30px -14px rgba(11,8,30,.6)}
.sold b{font-weight:600}
.sold span{color:var(--grey)}
.sold i{font-style:normal;color:var(--violet)}
.sold button{border:0;background:transparent;cursor:pointer;color:var(--grey);font-size:1rem;line-height:1;padding:0 2px}
@media(max-width:760px){.sold{top:12px;left:12px;font-size:.78rem;padding:7px 10px 7px 12px}}


/* ---------- comparatif coloré ---------- */
.cmp{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
.cmp table{border-collapse:collapse;width:100%;min-width:700px;font-size:.94rem}
.cmp th,.cmp td{padding:18px 20px;text-align:center;border-bottom:1px solid var(--line);vertical-align:middle}
.cmp thead th{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--grey);font-weight:500;padding-top:22px;padding-bottom:22px}
.cmp tbody th{text-align:left;font-weight:600;color:var(--ink);width:210px}
.cmp td{color:var(--grey)}
.cmp .us{background:rgba(107,98,206,.07)}
.cmp thead .us{color:var(--violet);font-weight:700;font-size:.8rem}
.cmp td.us{color:var(--ink);font-weight:600}
.cmp tr:last-child th,.cmp tr:last-child td{border-bottom:0}
.ic{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;font-size:.9rem;font-weight:700;line-height:1}
.ic.yes{background:var(--green);color:#fff;box-shadow:0 4px 12px -6px rgba(0,163,108,.8)}
.ic.no{background:#FCE4E9;color:#E0526F}
.ic.mid{background:#FDF0DA;color:#D9931F}
.ic.na{background:transparent;color:#C6C3D6;font-size:1.1rem;font-weight:400}
.cmp .save-row td{font-weight:600;color:var(--violet)}
.cmp-note{margin-top:16px;font-size:.82rem;color:var(--grey);text-align:center}


/* ---------- emplacement widget ---------- */
.slot2{display:flex;gap:18px;align-items:flex-start;margin-top:24px;padding:24px 26px;
  background:#fff;border:1.5px dashed var(--halo);border-radius:var(--radius)}
.slot2-ico{flex:none;width:40px;height:40px;border-radius:10px;background:var(--green);color:#fff;
  display:grid;place-items:center;font-size:1.1rem}
.slot2 b{display:block;font-family:"Poppins",sans-serif;letter-spacing:-.02em;margin-bottom:4px}
.slot2 p{font-size:.9rem;color:var(--grey)}

/* ---------- sections ---------- */
section{padding:62px 0}
.sec-head{max-width:640px;margin-bottom:30px}
.sec-head .lead{margin-top:14px}
.center{margin-left:auto;margin-right:auto;text-align:center}
.center .lead{margin-left:auto;margin-right:auto}
.aida{font-family:"IBM Plex Mono",monospace;font-size:.66rem;letter-spacing:.18em;color:var(--halo);text-transform:uppercase}

.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:30px 26px}
.card h3{margin-bottom:10px}
.card p{color:var(--grey);font-size:.95rem}
.card .price-tag{font-family:"IBM Plex Mono",monospace;font-size:.78rem;color:var(--violet);letter-spacing:.08em;margin-bottom:14px}
@media(max-width:860px){.cards{grid-template-columns:1fr}}

/* ---------- split image / texte ---------- */
.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.split.rev .split-txt{order:2}
.split .ph{aspect-ratio:4/5}
.split-txt .lead{margin-top:16px}
.ticks{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:12px}
.ticks li{display:flex;gap:12px;font-size:.97rem;color:var(--ink-soft)}
.ticks i{color:var(--violet);font-style:normal}
@media(max-width:880px){.split{grid-template-columns:1fr;gap:26px}.split.rev .split-txt{order:0}}

/* ---------- étapes avec visuels ---------- */
.step img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);margin-bottom:18px;display:block}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.step .ph{aspect-ratio:4/3;margin-bottom:20px}
.step-num{font-family:"IBM Plex Mono",monospace;font-size:.75rem;color:var(--violet);letter-spacing:.14em;margin-bottom:10px}
.step p{color:var(--grey);font-size:.95rem;margin-top:8px}
@media(max-width:860px){.steps{grid-template-columns:1fr}}

/* ---------- galerie produit ---------- */
.grid-shots{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.grid-shots .ph:nth-child(1){grid-column:span 2;grid-row:span 2;aspect-ratio:1/1}
.grid-shots .ph{aspect-ratio:1/1}
@media(max-width:860px){.grid-shots{grid-template-columns:repeat(2,1fr)}.grid-shots .ph:nth-child(1){grid-column:span 2;grid-row:auto}}

/* ---------- fréquence ---------- */
.freq{background:var(--ink);color:#fff;border-radius:26px;padding:54px 46px}
.freq h2{color:#fff}.freq .lead{color:rgba(255,255,255,.62)}.freq .eyebrow{color:var(--halo)}
.sweep{margin-top:38px}
.sweep-bar{position:relative;height:74px;border-radius:12px;background:linear-gradient(90deg,rgba(201,196,245,.12),rgba(201,196,245,.28));overflow:hidden}
.sweep-bar::after{content:"";position:absolute;top:0;bottom:0;width:120px;background:linear-gradient(90deg,transparent,rgba(201,196,245,.9),transparent);animation:sweep 5s ease-in-out infinite alternate}
@keyframes sweep{from{left:-120px}to{left:100%}}
@media(prefers-reduced-motion:reduce){.sweep-bar::after{animation:none;left:40%}}
.sweep-scale{display:flex;justify-content:space-between;margin-top:12px;font-family:"IBM Plex Mono",monospace;font-size:.74rem;color:rgba(255,255,255,.45);letter-spacing:.1em}
.freq-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:42px;border-top:1px solid rgba(255,255,255,.12);padding-top:30px}
.freq-stats b{display:block;font-family:"Poppins",sans-serif;font-size:1.9rem;letter-spacing:-.03em;margin-bottom:4px}
.freq-stats small{color:rgba(255,255,255,.5);font-size:.85rem}
@media(max-width:860px){.freq{padding:38px 24px}.freq-stats{grid-template-columns:1fr}}

/* ---------- transparence ---------- */
.honest{background:#fff;border:1px solid var(--line);border-radius:26px;padding:50px 44px}
.honest ul{list-style:none;padding:0;margin:32px 0 0;display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.honest li{padding-top:20px;border-top:2px solid var(--halo)}
.honest li p{color:var(--grey);font-size:.93rem;margin-top:8px}
@media(max-width:860px){.honest{padding:34px 24px}.honest ul{grid-template-columns:1fr}}

/* ---------- comparatif ---------- */
.table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);background:#fff}
table{border-collapse:collapse;width:100%;min-width:660px;font-size:.94rem}
th,td{padding:16px 18px;text-align:left;border-bottom:1px solid var(--line)}
thead th{font-family:"IBM Plex Mono",monospace;font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;color:var(--grey);font-weight:500}
tbody th{font-weight:600;color:var(--ink);width:200px}
td{color:var(--grey)}
.col-us{background:rgba(107,98,206,.06)}
thead .col-us{color:var(--violet)}
td.col-us{color:var(--ink);font-weight:600}
tr:last-child th,tr:last-child td{border-bottom:0}

/* ---------- avis façon plateforme ---------- */
.rev-head{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px 28px;margin-bottom:22px}
.rev-head .big{font-family:"Poppins",sans-serif;font-size:2.1rem;letter-spacing:-.04em}
.rev-head small{display:block;color:var(--grey);font-size:.85rem}
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.review{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column}
.review .ph{aspect-ratio:5/4;border-radius:0}
.review-body{padding:22px 24px 24px}
.review h3{font-size:1rem;margin:12px 0 8px}
.review p{font-size:.93rem;color:var(--ink-soft)}
.review footer{font-size:.83rem;color:var(--grey);margin-top:14px;display:flex;gap:8px;align-items:center}
.verif{color:var(--green);font-weight:600}
.slot{border:1.5px dashed var(--halo);border-radius:var(--radius);padding:20px;text-align:center;font-family:"IBM Plex Mono",monospace;font-size:.74rem;color:var(--violet);letter-spacing:.06em;margin-top:22px;line-height:1.7}
@media(max-width:860px){.reviews{grid-template-columns:1fr}}

/* ---------- garantie ---------- */
.guarantee{display:grid;grid-template-columns:auto 1fr;gap:34px;align-items:center;
  background:linear-gradient(120deg,rgba(107,98,206,.09),rgba(201,196,245,.16));border-radius:26px;padding:46px}
.seal{width:120px;height:120px;border-radius:50%;border:2px solid var(--violet);display:grid;place-items:center;text-align:center;font-family:"Poppins",sans-serif;font-weight:600;line-height:1.1;color:var(--violet);background:#fff}
.seal b{display:block;font-size:2rem;letter-spacing:-.04em}
.seal small{font-size:.68rem;letter-spacing:.06em;text-transform:uppercase}
@media(max-width:700px){.guarantee{grid-template-columns:1fr;padding:32px 24px;text-align:center;justify-items:center}}

/* ---------- faq ---------- */
details{border-bottom:1px solid var(--line);padding:20px 0}
summary{cursor:pointer;font-family:"Poppins",sans-serif;font-weight:500;font-size:1.04rem;letter-spacing:-.02em;list-style:none;display:flex;justify-content:space-between;gap:20px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--violet);font-size:1.3rem;flex:none}
details[open] summary::after{content:"–"}
details p{color:var(--grey);font-size:.95rem;margin-top:12px;max-width:70ch}

/* ---------- cta final ---------- */
.final{position:relative;border-radius:26px;overflow:hidden;min-height:420px;display:grid;align-items:center;text-align:center}
.final .ph{position:absolute;inset:0;border-radius:0}
.final-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(23,19,52,.55),rgba(23,19,52,.85))}
.final-inner{position:relative;padding:70px 26px}
.final h2{color:#fff;margin-bottom:16px}
.final p{color:rgba(255,255,255,.72);max-width:46ch;margin:0 auto 30px}

footer.site{background:var(--ink);color:#fff;margin-top:0;padding:64px 0 34px}
.foot-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:30px}
.foot-grid h4{font-family:"IBM Plex Mono",monospace;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#fff;margin:0 0 14px;font-weight:500}
.foot-grid ul{list-style:none;padding:0;margin:0;font-size:.92rem;color:rgba(255,255,255,.66)}
.foot-grid li{margin-bottom:9px}
.foot-grid a{text-decoration:none}
.foot-grid a:hover{color:var(--halo)}
footer.site .wordmark{color:#fff;text-shadow:none}
.foot-tag{color:rgba(255,255,255,.6);font-size:.9rem;margin-top:12px;max-width:34ch}
.legal{margin-top:42px;padding-top:22px;border-top:1px solid rgba(255,255,255,.14);font-size:.8rem;color:rgba(255,255,255,.48);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
@media(max-width:860px){.foot-grid{grid-template-columns:1fr 1fr}}


/* ---------- grille nuisibles ---------- */
.pests{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.pests li{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);
  border-radius:100px;padding:12px 22px;font-size:.96rem;font-weight:500;color:var(--ink);
  box-shadow:0 6px 16px -14px rgba(23,19,52,.5);transition:border-color .15s,transform .15s}
.pests li:hover{border-color:var(--halo);transform:translateY(-2px)}
.pests li i{font-style:normal;font-size:1.15rem;line-height:1}
.pests-note{margin:30px auto 0;max-width:64ch;text-align:center;font-size:.86rem;color:var(--grey)}
/* ---------- packshot réel ---------- */
.shot-img{width:100%;height:100%;object-fit:cover;border-radius:var(--radius);background:#EFEDFB}
.grid-shots .shot-img{grid-column:span 2;grid-row:span 2;aspect-ratio:1/1}
@media(max-width:860px){.grid-shots .shot-img{grid-column:span 2;grid-row:auto}}
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:80;background:#fff;border-top:1px solid var(--line);
  padding:12px 18px calc(12px + env(safe-area-inset-bottom));display:none;align-items:center;gap:14px;
  box-shadow:0 -8px 24px -12px rgba(23,19,52,.25)}
.sticky b{font-family:"Poppins",sans-serif;font-size:1.15rem;letter-spacing:-.03em}
.sticky small{display:block;color:var(--grey);font-size:.75rem}
.sticky .btn{flex:1;padding:15px 18px}
@media(max-width:880px){.sticky{display:flex}body{padding-bottom:80px}}


