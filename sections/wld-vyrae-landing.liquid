{%- liquid
  assign slug = 'vyrae'
  assign p = section.settings.product
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<section id="wld-{{ slug }}-{{ section.id }}" class="wld-{{ slug }}">

  {%- capture pay_badges -%}
    {%- if section.settings.pay_visa -%}<span class="wld-pay__badge"><svg height="13" viewBox="0 0 64 21" role="img" aria-label="Visa"><text x="0" y="17" font-family="Arial,Helvetica,sans-serif" font-size="21" font-style="italic" font-weight="700" fill="#1A1F71">VISA</text></svg></span>{%- endif -%}
    {%- if section.settings.pay_mastercard -%}<span class="wld-pay__badge"><svg height="20" viewBox="0 0 40 25" role="img" aria-label="Mastercard"><circle cx="16" cy="12.5" r="10" fill="#EB001B"/><circle cx="24" cy="12.5" r="10" fill="#F79E1B"/><path d="M20 5.2a10 10 0 0 1 0 14.6 10 10 0 0 1 0-14.6z" fill="#FF5F00"/></svg></span>{%- endif -%}
    {%- if section.settings.pay_amex -%}<span class="wld-pay__badge"><svg height="20" viewBox="0 0 40 25" role="img" aria-label="American Express"><rect width="40" height="25" rx="3" fill="#2E77BC"/><text x="20" y="11" text-anchor="middle" font-family="Arial" font-weight="700" font-size="6.5" fill="#fff">AMERICAN</text><text x="20" y="20" text-anchor="middle" font-family="Arial" font-weight="700" font-size="6.5" fill="#fff">EXPRESS</text></svg></span>{%- endif -%}
    {%- if section.settings.pay_paypal -%}<span class="wld-pay__badge"><svg height="14" viewBox="0 0 76 20" role="img" aria-label="PayPal"><text x="0" y="16" font-family="Arial" font-weight="700" font-style="italic" font-size="18" fill="#003087">Pay</text><text x="35" y="16" font-family="Arial" font-weight="700" font-style="italic" font-size="18" fill="#009CDE">Pal</text></svg></span>{%- endif -%}
    {%- if section.settings.pay_applepay -%}<span class="wld-pay__badge"><svg height="16" viewBox="0 0 60 24" role="img" aria-label="Apple Pay"><path fill="#000" d="M11.79 5.66c.5-.62.84-1.46.75-2.31-.72.03-1.6.48-2.12 1.1-.46.54-.87 1.41-.76 2.24.81.06 1.63-.41 2.13-1.03z M12.53 6.84c-1.18-.07-2.18.67-2.74.67-.56 0-1.42-.64-2.34-.62-1.2.02-2.31.7-2.93 1.78-1.25 2.17-.32 5.38.9 7.14.6.86 1.31 1.83 2.24 1.79.9-.04 1.24-.58 2.33-.58 1.08 0 1.39.58 2.34.56.97-.02 1.58-.87 2.17-1.74.69-1 .97-1.97.98-2.02-.02-.01-1.88-.72-1.9-2.86-.02-1.79 1.46-2.64 1.53-2.69-.84-1.23-2.14-1.37-2.6-1.4z"/><text x="20" y="18" font-family="Arial,Helvetica,sans-serif" font-weight="500" font-size="17" fill="#000">Pay</text></svg></span>{%- endif -%}
    {%- if section.settings.pay_shoppay -%}<span class="wld-pay__badge"><svg height="16" viewBox="0 0 74 24" role="img" aria-label="Shop Pay"><rect width="44" height="24" rx="6" fill="#5A31F4"/><text x="22" y="17" text-anchor="middle" font-family="Arial" font-weight="700" font-size="13" fill="#fff">shop</text><text x="48" y="17" font-family="Arial" font-weight="700" font-size="13" fill="#5A31F4">Pay</text></svg></span>{%- endif -%}
    {%- if section.settings.pay_cb -%}<span class="wld-pay__badge"><svg height="16" viewBox="0 0 34 24" role="img" aria-label="Carte Bancaire"><text x="1" y="19" font-family="Arial" font-weight="800" font-size="19" fill="#214B8C">C</text><text x="15" y="19" font-family="Arial" font-weight="800" font-size="19" fill="#3AA935">B</text></svg></span>{%- endif -%}
  {%- endcapture -%}

  {%- capture brand_logo -%}
    {%- if section.settings.footer_logo != blank -%}
      <img src="{{ section.settings.footer_logo | image_url: width: 320 }}" alt="{{ section.settings.brand_name | escape }}" width="150" height="44">
    {%- else -%}
      <span class="wld-logo__mark"><svg viewBox="0 0 40 40" width="34" height="34" role="img" aria-label="{{ section.settings.brand_name | escape }}"><rect class="wld-tile" width="40" height="40" rx="9"/><path class="wld-vee" d="M11 12.5 L20 29 L29 12.5" fill="none" stroke-width="5" stroke-linejoin="miter"/></svg></span>
      <span class="wld-logo__word">{{ section.settings.brand_name }}</span>
    {%- endif -%}
  {%- endcapture -%}

  {%- unless p != blank -%}
    <div class="vel-no-product-notice">
      ⚠️ Aucun produit sélectionné. Ouvrez l'éditeur de thème → réglages de la section « WLD — Vyrae Landing » → choisissez votre produit pour activer le panier.
    </div>
  {%- endunless -%}

  {%- comment -%} ====================== BANDE ANNONCE + HEADER ====================== {%- endcomment -%}
  <div class="wld-announce">{{ section.settings.announce_text }}</div>
  <header class="wld-header">
    <a href="#wld-top" class="wld-logo">{{ brand_logo }}</a>
    <a href="#wld-top" class="wld-header__cta">{{ section.settings.header_cta }}</a>
  </header>

  {%- comment -%} ====================== HERO ====================== {%- endcomment -%}
  <div class="wld-hero" id="wld-top">
    <div class="wld-wrap wld-hero__grid">
      <div class="wld-hero__media">
        {%- if section.settings.hero_image != blank -%}
          <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.hero_title | escape }}" loading="eager" width="600" height="600">
        {%- else -%}
          <div class="wld-ph wld-ph--square">Image produit</div>
        {%- endif -%}
        <div class="wld-hero__pills">
          <span>{{ section.settings.hero_pill_1 }}</span>
          <span>{{ section.settings.hero_pill_2 }}</span>
          <span>{{ section.settings.hero_pill_3 }}</span>
        </div>
      </div>

      <div class="wld-hero__box">
        <div class="wld-stars">★★★★★ <span>{{ section.settings.hero_reviews_label }}</span></div>
        <h1 class="wld-h1">{{ section.settings.hero_title }}</h1>
        <p class="wld-hero__sub">{{ section.settings.hero_subtitle }}</p>

        <ul class="wld-hero__ticks">
          <li>{{ section.settings.hero_tick_1 }}</li>
          <li>{{ section.settings.hero_tick_2 }}</li>
          <li>{{ section.settings.hero_tick_3 }}</li>
        </ul>

        {%- form 'product', p, class: 'wld-buy', id: 'wld-hero-form-' | append: section.id -%}
          <div class="wld-selector">
            <div class="wld-selector__head"><span class="wld-selector__label">Couleur</span><span class="wld-selector__val" data-color-val></span></div>
            <div class="wld-swatches" data-swatches>
              {%- for i in (1..3) -%}
                {%- assign cn = 'color_opt_' | append: i | append: '_name' -%}
                {%- assign ch = 'color_opt_' | append: i | append: '_hex' -%}
                {%- if section.settings[cn] != blank -%}
                  <button type="button" class="wld-swatch" data-name="{{ section.settings[cn] | escape }}" style="--sw:{{ section.settings[ch] }}" title="{{ section.settings[cn] | escape }}" aria-label="{{ section.settings[cn] | escape }}"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <input type="hidden" name="properties[Couleur]" data-color-input>
          </div>

          <div class="wld-selector">
            <div class="wld-selector__head"><span class="wld-selector__label">Taille</span>{%- if section.settings.size_guide_url != blank -%}<a class="wld-size-guide" href="{{ section.settings.size_guide_url }}">{{ section.settings.size_guide_label }}</a>{%- endif -%}</div>
            <div class="wld-sizes" data-sizes>
              {%- assign sizes = section.settings.sizes_list | split: ',' -%}
              {%- for s in sizes -%}
                {%- assign sv = s | strip -%}
                <button type="button" class="wld-size" data-size="{{ sv | escape }}">{{ sv }}</button>
              {%- endfor -%}
            </div>
            <p class="wld-size-error" data-size-error>Veuillez choisir une taille.</p>
            <input type="hidden" name="properties[Taille]" data-size-input>
          </div>

          <p class="wld-offer-note">{{ section.settings.hero_offer_note }}</p>
          <div class="wld-bundles" data-bundles>
            <label class="wld-bundle" data-variant="{{ section.settings.b1_variant }}">
              <input type="radio" name="hero-bundle">
              <span class="wld-bundle__top"><strong>{{ section.settings.b1_title }}</strong>{% if section.settings.b1_tag != blank %}<em class="wld-bundle__tag">{{ section.settings.b1_tag }}</em>{% endif %}</span>
              <span class="wld-bundle__sub">{{ section.settings.b1_sub }}</span>
              <span class="wld-bundle__price">{{ section.settings.b1_price }} <s>{{ section.settings.b1_compare }}</s></span>
            </label>
            <label class="wld-bundle wld-bundle--feat" data-variant="{{ section.settings.b2_variant }}" data-default="true">
              <input type="radio" name="hero-bundle" checked>
              <span class="wld-bundle__top"><strong>{{ section.settings.b2_title }}</strong>{% if section.settings.b2_tag != blank %}<em class="wld-bundle__tag">{{ section.settings.b2_tag }}</em>{% endif %}</span>
              <span class="wld-bundle__sub">{{ section.settings.b2_sub }}</span>
              <span class="wld-bundle__price">{{ section.settings.b2_price }} <s>{{ section.settings.b2_compare }}</s></span>
            </label>
            <label class="wld-bundle" data-variant="{{ section.settings.b3_variant }}">
              <input type="radio" name="hero-bundle">
              <span class="wld-bundle__top"><strong>{{ section.settings.b3_title }}</strong>{% if section.settings.b3_tag != blank %}<em class="wld-bundle__tag">{{ section.settings.b3_tag }}</em>{% endif %}</span>
              <span class="wld-bundle__sub">{{ section.settings.b3_sub }}</span>
              <span class="wld-bundle__price">{{ section.settings.b3_price }} <s>{{ section.settings.b3_compare }}</s></span>
            </label>
          </div>

          <input type="hidden" name="id" data-variant-input value="{{ section.settings.b2_variant }}">
          <button type="submit" class="wld-cta wld-cta--block"{% unless p != blank %} disabled{% endunless %}>{{ section.settings.hero_cta }}</button>
          <p class="wld-buy__guarantee">{{ section.settings.hero_guarantee }}</p>
        {%- endform -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== PRESS STRIP ====================== {%- endcomment -%}
  <div class="wld-press">
    <div class="wld-wrap">
      <p class="wld-press__label">{{ section.settings.press_label }}</p>
      <div class="wld-press__logos">
        <span>{{ section.settings.press_1 }}</span>
        <span>{{ section.settings.press_2 }}</span>
        <span>{{ section.settings.press_3 }}</span>
        <span>{{ section.settings.press_4 }}</span>
      </div>
    </div>
  </div>

  {%- comment -%} ====================== BRAND STORY — POURQUOI ON A CRÉÉ VYRAE ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap wld-story">
      <div class="wld-story__media">
        {%- if section.settings.story_image != blank -%}
          <img src="{{ section.settings.story_image | image_url: width: 800 }}" alt="{{ section.settings.story_title | escape }}" loading="lazy" width="400" height="460">
        {%- else -%}<div class="wld-ph wld-ph--port">Photo fondatrice / atelier</div>{%- endif -%}
      </div>
      <div class="wld-story__txt">
        <p class="wld-eyebrow">{{ section.settings.story_eyebrow }}</p>
        <h2 class="wld-h2 wld-h2--left">{{ section.settings.story_title }}</h2>
        <p>{{ section.settings.story_p1 }}</p>
        <p>{{ section.settings.story_p2 }}</p>
        <p class="wld-story__sign">{{ section.settings.story_sign }}</p>
      </div>
    </div>
  </div>

  {%- comment -%} ====================== PROBLEM ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.problem_title }}</h2>
      <div class="wld-ba">
        <figure>
          {%- if section.settings.problem_before != blank -%}
            <img src="{{ section.settings.problem_before | image_url: width: 700 }}" alt="Avant" loading="lazy" width="350" height="420">
          {%- else -%}<div class="wld-ph wld-ph--port">Avant</div>{%- endif -%}
          <figcaption>{{ section.settings.problem_before_cap }}</figcaption>
        </figure>
        <figure>
          {%- if section.settings.problem_after != blank -%}
            <img src="{{ section.settings.problem_after | image_url: width: 700 }}" alt="Après" loading="lazy" width="350" height="420">
          {%- else -%}<div class="wld-ph wld-ph--port">Après</div>{%- endif -%}
          <figcaption>{{ section.settings.problem_after_cap }}</figcaption>
        </figure>
      </div>
      <ul class="wld-checklist">
        <li>{{ section.settings.problem_pt_1 }}</li>
        <li>{{ section.settings.problem_pt_2 }}</li>
        <li>{{ section.settings.problem_pt_3 }}</li>
        <li>{{ section.settings.problem_pt_4 }}</li>
      </ul>
    </div>
  </div>

  {%- comment -%} ====================== SCIENCE / PREUVES ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <p class="wld-eyebrow wld-eyebrow--center">{{ section.settings.science_eyebrow }}</p>
      <h2 class="wld-h2">{{ section.settings.science_title }}</h2>
      <p class="wld-lead">{{ section.settings.science_intro }}</p>
      <div class="wld-stats">
        {%- for i in (1..4) -%}
          {%- assign st = 'science_stat_' | append: i -%}
          {%- assign lb = 'science_label_' | append: i -%}
          <div class="wld-stat">
            <span class="wld-stat__num">{{ section.settings[st] }}</span>
            <span class="wld-stat__label">{{ section.settings[lb] }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="wld-cards3 wld-science-cards">
        {%- for i in (1..3) -%}
          {%- assign tt = 'science_card_title_' | append: i -%}
          {%- assign tx = 'science_card_text_' | append: i -%}
          <article class="wld-card wld-card--science">
            <span class="wld-card__icon">🔬</span>
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
          </article>
        {%- endfor -%}
      </div>
      <p class="wld-footnote">{{ section.settings.science_footnote }}</p>
    </div>
  </div>

  {%- comment -%} ====================== BENEFITS / ROOT CAUSE ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.benefits_title }}</h2>
      <div class="wld-cards3">
        {%- for i in (1..3) -%}
          {%- assign img = 'benefit_img_' | append: i -%}
          {%- assign tt = 'benefit_title_' | append: i -%}
          {%- assign tx = 'benefit_text_' | append: i -%}
          <article class="wld-card">
            {%- if section.settings[img] != blank -%}
              <img src="{{ section.settings[img] | image_url: width: 600 }}" alt="" loading="lazy" width="300" height="220">
            {%- else -%}<div class="wld-ph">Image</div>{%- endif -%}
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
            <div class="wld-stars wld-stars--sm">★★★★★</div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== MYTH (3 col) ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.myth_title }}</h2>
      <div class="wld-cards3 wld-cards3--text">
        {%- for i in (1..3) -%}
          {%- assign tt = 'myth_title_' | append: i -%}
          {%- assign tx = 'myth_text_' | append: i -%}
          <article class="wld-card wld-card--plain">
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== METHOD COMPARE ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap wld-method">
      <div class="wld-method__col wld-method__col--bad">
        <h3>{{ section.settings.method_bad_title }}</h3>
        <ul class="wld-x">
          <li>{{ section.settings.method_bad_1 }}</li>
          <li>{{ section.settings.method_bad_2 }}</li>
          <li>{{ section.settings.method_bad_3 }}</li>
        </ul>
      </div>
      <div class="wld-method__col wld-method__col--good">
        <h3>{{ section.settings.method_good_title }}</h3>
        <ul class="wld-checklist">
          <li>{{ section.settings.method_good_1 }}</li>
          <li>{{ section.settings.method_good_2 }}</li>
          <li>{{ section.settings.method_good_3 }}</li>
        </ul>
      </div>
    </div>
  </div>

  {%- comment -%} ====================== FORMULA / TECH (4 features) ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.tech_title }}</h2>
      <div class="wld-cards4">
        {%- for i in (1..4) -%}
          {%- assign img = 'tech_img_' | append: i -%}
          {%- assign tt = 'tech_title_' | append: i -%}
          {%- assign tx = 'tech_text_' | append: i -%}
          <article class="wld-card">
            {%- if section.settings[img] != blank -%}
              <img src="{{ section.settings[img] | image_url: width: 500 }}" alt="" loading="lazy" width="250" height="170">
            {%- else -%}<div class="wld-ph">Image</div>{%- endif -%}
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
          </article>
        {%- endfor -%}
      </div>
      <p class="wld-footnote">{{ section.settings.tech_footnote }}</p>
    </div>
  </div>

  {%- comment -%} ====================== MIRROR RESULTS — GALERIE AVANT/APRÈS ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.mirror_title }}</h2>
      <p class="wld-lead">{{ section.settings.mirror_intro }}</p>
      <div class="wld-grid8">
        {%- for i in (1..8) -%}
          {%- assign img = 'mirror_img_' | append: i -%}
          {%- assign cap = 'mirror_cap_' | append: i -%}
          <figure class="wld-grid8__item">
            {%- if section.settings[img] != blank -%}
              <img src="{{ section.settings[img] | image_url: width: 420 }}" alt="" loading="lazy" width="210" height="240">
            {%- else -%}<div class="wld-ph wld-ph--mini">Avant / Après</div>{%- endif -%}
            <figcaption>{{ section.settings[cap] }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
      <a href="#wld-top" class="wld-cta">{{ section.settings.cta_gallery }}</a>
    </div>
  </div>

  {%- comment -%} ====================== EXPERT — MÉDECIN / KINÉ ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap wld-expert">
      <div class="wld-expert__media">
        {%- if section.settings.expert_image != blank -%}
          <img src="{{ section.settings.expert_image | image_url: width: 800 }}" alt="{{ section.settings.expert_name | escape }}" loading="lazy" width="400" height="480">
        {%- else -%}<div class="wld-ph wld-ph--port">Photo médecin / kiné</div>{%- endif -%}
        <span class="wld-expert__badge">{{ section.settings.expert_badge }}</span>
      </div>
      <div class="wld-expert__txt">
        <p class="wld-eyebrow">{{ section.settings.expert_eyebrow }}</p>
        <h2 class="wld-h2 wld-h2--left">{{ section.settings.expert_title }}</h2>
        <p>{{ section.settings.expert_text }}</p>
        <blockquote class="wld-expert__quote">{{ section.settings.expert_quote }}</blockquote>
        <p class="wld-expert__name">{{ section.settings.expert_name }}<br><em>{{ section.settings.expert_role }}</em></p>
      </div>
    </div>
  </div>

  {%- comment -%} ====================== TIMELINE — JOUR 1-3 → SEMAINES + AVIS ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.timeline_title }}</h2>
      <p class="wld-lead">{{ section.settings.timeline_intro }}</p>
      <div class="wld-timeline">
        {%- for i in (1..4) -%}
          {%- assign tt = 'timeline_step_' | append: i -%}
          {%- assign tx = 'timeline_text_' | append: i -%}
          {%- assign qt = 'timeline_quote_' | append: i -%}
          <div class="wld-timeline__item">
            <span class="wld-timeline__dot"></span>
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
            <p class="wld-timeline__quote">{{ section.settings[qt] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== HOW TO (3 steps) ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.how_title }}</h2>
      <div class="wld-cards3">
        {%- for i in (1..3) -%}
          {%- assign img = 'how_img_' | append: i -%}
          {%- assign tt = 'how_title_' | append: i -%}
          {%- assign tx = 'how_text_' | append: i -%}
          <article class="wld-card wld-step">
            <span class="wld-step__num">{{ i }}</span>
            {%- if section.settings[img] != blank -%}
              <img src="{{ section.settings[img] | image_url: width: 600 }}" alt="" loading="lazy" width="300" height="220">
            {%- else -%}<div class="wld-ph">Image</div>{%- endif -%}
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== AVANTAGES / GARANTIES ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.adv_title }}</h2>
      <p class="wld-lead">{{ section.settings.adv_intro }}</p>
      <div class="wld-cards3">
        {%- for i in (1..6) -%}
          {%- assign ic = 'adv_icon_' | append: i -%}
          {%- assign tt = 'adv_title_' | append: i -%}
          {%- assign tx = 'adv_text_' | append: i -%}
          <article class="wld-card wld-adv">
            <span class="wld-adv__icon">{{ section.settings[ic] }}</span>
            <h3>{{ section.settings[tt] }}</h3>
            <p>{{ section.settings[tx] }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== COMPARISON TABLE ====================== {%- endcomment -%}
  <div class="wld-block wld-block--cream">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.compare_title }}</h2>
      <div class="wld-table-wrap">
        <table class="wld-table">
          <thead>
            <tr>
              <th></th>
              <th class="wld-table__us">{{ section.settings.compare_us }}</th>
              <th>{{ section.settings.compare_alt1 }}</th>
              <th>{{ section.settings.compare_alt2 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for i in (1..4) -%}
              {%- assign row = 'compare_row_' | append: i -%}
              {%- assign u = 'compare_us_' | append: i -%}
              {%- assign a1 = 'compare_a1_' | append: i -%}
              {%- assign a2 = 'compare_a2_' | append: i -%}
              <tr>
                <td>{{ section.settings[row] }}</td>
                <td class="wld-table__us">{{ section.settings[u] }}</td>
                <td>{{ section.settings[a1] }}</td>
                <td>{{ section.settings[a2] }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <a href="#wld-top" class="wld-cta">{{ section.settings.cta_compare }}</a>
    </div>
  </div>

  {%- comment -%} ====================== REVIEWS (blocks) ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap">
      <h2 class="wld-h2">{{ section.settings.reviews_title }}</h2>
      <div class="wld-reviews">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            {%- assign r = block.settings.rating | default: '5' | times: 1 -%}
            <article class="wld-review" {{ block.shopify_attributes }}>
              <div class="wld-stars wld-stars--sm">{% for i in (1..5) %}{% if i <= r %}★{% else %}☆{% endif %}{% endfor %}</div>
              <p class="wld-review__body">{{ block.settings.body }}</p>
              <p class="wld-review__author">— {{ block.settings.author }} <span>✔ {{ block.settings.verified }}</span></p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} ====================== FAQ (blocks) ====================== {%- endcomment -%}
  <div class="wld-block">
    <div class="wld-wrap wld-wrap--narrow">
      <h2 class="wld-h2">{{ section.settings.faq_title }}</h2>
      <div class="wld-faq">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="wld-faq__item" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.q }}</summary>
              <div class="wld-faq__a">{{ block.settings.a }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <a href="#wld-top" class="wld-cta">{{ section.settings.cta_faq }}</a>
    </div>
  </div>

  {%- comment -%} ====================== FOOTER ====================== {%- endcomment -%}
  <div class="wld-footer">
    <div class="wld-wrap wld-footer__grid">
      <div class="wld-footer__brand">
        <span class="wld-logo wld-logo--footer">{{ brand_logo }}</span>
        <p>{{ section.settings.footer_about }}</p>
      </div>
      <div class="wld-footer__col">
        <h4>{{ section.settings.footer_info_title }}</h4>
        <ul class="wld-footer__links">
          {%- if section.settings.footer_menu != blank -%}
            {%- for link in linklists[section.settings.footer_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            {%- assign info_items = section.settings.footer_info_fallback | split: ',' -%}
            {%- for it in info_items -%}<li>{{ it | strip }}</li>{%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      <div class="wld-footer__col">
        <h4>{{ section.settings.footer_contact_title }}</h4>
        <p>{{ section.settings.footer_email }}</p>
        <p>{{ section.settings.footer_phone }}</p>
      </div>
    </div>

    <div class="wld-footer__bottom">
      <div class="wld-pay">{{ pay_badges }}</div>

      <p class="wld-footer__copy">{{ section.settings.footer_legal }}</p>

      {%- if section.settings.footer_disclaimer != blank -%}
        <p class="wld-footer__disclaimer">{{ section.settings.footer_disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
