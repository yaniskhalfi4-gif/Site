  #wld-{{ slug }}-{{ section.id }} .wld-offer-note{background:color-mix(in srgb,var(--c-primary) 12%,#fff);color:var(--c-primary-dark);border:1px dashed var(--c-primary);border-radius:10px;padding:9px 12px;margin:0 0 12px;font-size:13px;font-weight:600;text-align:center}
