<script>
(function(){
  function initSection(root){
    if(!root) return;
    root.querySelectorAll('[data-swatches]').forEach(function(group){
      var form = group.closest('form');
      var input = form ? form.querySelector('[data-color-input]') : null;
      var val = form ? form.querySelector('[data-color-val]') : null;
      var swatches = group.querySelectorAll('.wld-swatch');
      function activate(el){
        swatches.forEach(function(b){ b.classList.remove('is-active'); });
        el.classList.add('is-active');
        var n = el.getAttribute('data-name');
        if(input) input.value = n;
        if(val) val.textContent = n;
      }
      swatches.forEach(function(el){ el.addEventListener('click', function(){ activate(el); }); });
      if(swatches[0]) activate(swatches[0]);
    });
    root.querySelectorAll('[data-sizes]').forEach(function(group){
      var form = group.closest('form');
      var input = form ? form.querySelector('[data-size-input]') : null;
      var err = form ? form.querySelector('[data-size-error]') : null;
      var sizes = group.querySelectorAll('.wld-size');
      sizes.forEach(function(el){
        el.addEventListener('click', function(){
          sizes.forEach(function(b){ b.classList.remove('is-active'); });
          el.classList.add('is-active');
          if(input) input.value = el.getAttribute('data-size');
          group.classList.remove('wld-sizes--error');
          if(err) err.style.display = 'none';
        });
      });
    });
    root.querySelectorAll('form.wld-buy').forEach(function(form){
      form.addEventListener('submit', function(e){
        var si = form.querySelector('[data-size-input]');
        var sizesGroup = form.querySelector('[data-sizes]');
        if(si && sizesGroup && !si.value){
          e.preventDefault();
          sizesGroup.classList.add('wld-sizes--error');
          var err = form.querySelector('[data-size-error]');
          if(err) err.style.display = 'block';
          sizesGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
    root.querySelectorAll('[data-bundles]').forEach(function(group){
      var form = group.closest('form');
      var input = form ? form.querySelector('[data-variant-input]') : null;
      var bundles = group.querySelectorAll('.wld-bundle');
      function activate(el){
        bundles.forEach(function(b){ b.classList.remove('is-active'); });
        el.classList.add('is-active');
        var radio = el.querySelector('input[type=radio]');
        if(radio) radio.checked = true;
        if(input && el.getAttribute('data-variant')){
          input.value = el.getAttribute('data-variant');
        }
      }
      bundles.forEach(function(el){
        el.addEventListener('click', function(){ activate(el); });
      });
      var def = group.querySelector('.wld-bundle[data-default]') || bundles[0];
      if(def) activate(def);
    });
  }
  function boot(){
    document.querySelectorAll('[id^="wld-{{ slug }}-"]').forEach(initSection);
  }
  if(document.readyState !== 'loading'){ boot(); }
  else { document.addEventListener('DOMContentLoaded', boot); }

  document.addEventListener('shopify:section:load', function(e){
    var el = e.target.querySelector('[id^="wld-{{ slug }}-"]') || e.target;
    initSection(el);
  });
})();
</script>

