  #wld-{{ slug }}-{{ section.id }} .wld-swatch:hover{transform:scale(1.05)}
  #wld-{{ slug }}-{{ section.id }} .wld-swatch.is-active{box-shadow:0 0 0 2px #fff,0 0 0 4px var(--c-primary)}
  #wld-{{ slug }}-{{ section.id }} .wld-sizes{display:flex;flex-wrap:wrap;gap:8px}
  #wld-{{ slug }}-{{ section.id }} .wld-size{min-width:48px;padding:11px 12px;border:2px solid #dbe5ed;border-radius:10px;background:#fff;font-weight:700;font-size:14px;color:var(--c-text);cursor:pointer;transition:.15s}
  #wld-{{ slug }}-{{ section.id }} .wld-size:hover{border-color:var(--c-primary)}
  #wld-{{ slug }}-{{ section.id }} .wld-size.is-active{border-color:var(--c-primary);background:color-mix(in srgb,var(--c-primary) 12%,#fff);color:var(--c-primary-dark)}
