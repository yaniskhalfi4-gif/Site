  #wld-{{ slug }}-{{ section.id }} .wld-header__cta:hover{background:var(--c-primary-dark)}

  #wld-{{ slug }}-{{ section.id }} .wld-stars{color:var(--c-accent);font-size:18px;letter-spacing:2px}
