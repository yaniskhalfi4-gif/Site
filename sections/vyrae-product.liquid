<script>

  document.querySelectorAll('[data-gallery]').forEach(function(g){
    var layers=Array.prototype.slice.call(g.querySelectorAll('.wld-gallery__layer'));
    var thumbs=Array.prototype.slice.call(g.querySelectorAll('.wld-gallery__thumb'));
    var idx=0, front=0;
    thumbs.forEach(function(t){var im=new Image();im.src=t.getAttribute('data-full');});
    function show(i){
      if(i<0)i=thumbs.length-1; if(i>=thumbs.length)i=0; idx=i;
      var t=thumbs[i]; if(!t)return;
      thumbs.forEach(function(x){x.classList.remove('is-active')});
      t.classList.add('is-active');
      var strip=t.parentNode;
      if(strip&&strip.scrollWidth>strip.clientWidth){strip.scrollLeft=t.offsetLeft-strip.offsetLeft-(strip.clientWidth-t.offsetWidth)/2;}
      var src=t.getAttribute('data-full');
      var cur=layers[front], nxt=layers[1-front];
      if(!nxt){cur.src=src;return;}
      if(cur.getAttribute('src')===src)return;
      nxt.src=src;
      void nxt.offsetWidth;
      nxt.classList.add('is-on');
      cur.classList.remove('is-on');
      front=1-front;
    }
    function bind(el,fn){
      if(!el)return;
      el.addEventListener('mousedown',function(e){e.preventDefault();});
      el.addEventListener('click',function(e){e.preventDefault();fn();try{el.blur();}catch(_){}});
    }
    thumbs.forEach(function(t,i){bind(t,function(){show(i);});});
    bind(g.querySelector('.wld-gallery__nav--prev'),function(){show(idx-1);});
    bind(g.querySelector('.wld-gallery__nav--next'),function(){show(idx+1);});
    var box=g.querySelector('.wld-gallery__main'), x0=null;
    if(box){
      box.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
      box.addEventListener('touchend',function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;if(Math.abs(dx)>40){show(idx+(dx<0?1:-1))}x0=null},{passive:true});
    }
    g._galShow=show;
    g._galThumbs=thumbs;
  });
  document.querySelectorAll('[data-swatches]').forEach(function(group){
    var input=group.parentNode.querySelector('[data-color-input]');
    var val=group.parentNode.querySelector('[data-color-val]');
    var sw=group.querySelectorAll('.wld-swatch');
    var gal=document.querySelector('[data-gallery]');
    function act(el,jump){
      sw.forEach(function(b){b.classList.remove('is-active')});el.classList.add('is-active');
      var n=el.getAttribute('data-name');if(input)input.value=n;if(val)val.textContent=n;
      if(jump&&gal&&gal._galThumbs){
        for(var i=0;i<gal._galThumbs.length;i++){
          if(gal._galThumbs[i].getAttribute('data-color')===n){gal._galShow(i);break;}
        }
      }
    }
    sw.forEach(function(el){el.addEventListener('click',function(){act(el,true)})});
    if(sw[0])act(sw[0],false);
  });
  document.querySelectorAll('[data-sizes]').forEach(function(group){
    var input=group.parentNode.querySelector('[data-size-input]');
    var err=group.parentNode.querySelector('[data-size-error]');
    var sz=group.querySelectorAll('.wld-size');
    sz.forEach(function(el){el.addEventListener('click',function(){sz.forEach(function(b){b.classList.remove('is-active')});el.classList.add('is-active');if(input)input.value=el.getAttribute('data-size');group.classList.remove('wld-sizes--error');if(err)err.style.display='none';});});
  });
  document.querySelectorAll('[data-bundles]').forEach(function(group){
    var bundles = group.querySelectorAll('.wld-bundle');
    function activate(el){bundles.forEach(function(b){b.classList.remove('is-active')});el.classList.add('is-active');var r=el.querySelector('input');if(r)r.checked=true;}
    bundles.forEach(function(el){el.addEventListener('click',function(){activate(el)})});
    var def=group.querySelector('.wld-bundle[data-default]')||bundles[0];if(def)activate(def);
  });


  (function(){
    var root=document.getElementById('vyrae-app'); if(!root) return;
    var island=root.querySelector('[data-vyrae-variants]'); var variants=[];
    try{ variants=JSON.parse(island.textContent||'[]'); }catch(e){}
    var colorInput=root.querySelector('[data-color-input]');
    var sizeInput=root.querySelector('[data-size-input]');
    var sizeErr=root.querySelector('[data-size-error]');
    var sizesBox=root.querySelector('[data-sizes]');
    function qty(){ var b=root.querySelector('.wld-bundle.is-active'); var q=b&&b.getAttribute('data-qty'); return q?parseInt(q,10):1; }
    function findVariant(color,size){
      color=(color||'').trim().toLowerCase(); size=(size||'').trim().toLowerCase();
      for(var i=0;i<variants.length;i++){
        var o=(variants[i].options||[]).map(function(x){return (x||'').toString().trim().toLowerCase();});
        if(o.indexOf(color)>-1 && o.indexOf(size)>-1) return variants[i];
      }
      return null;
    }
    function handler(btn){ return function(e){
      e.preventDefault();
      if(!variants.length){ window.location='/cart'; return; }
      var size=sizeInput?sizeInput.value:'';
      if(!size){ if(sizeErr)sizeErr.style.display='block'; if(sizesBox){sizesBox.classList.add('wld-sizes--error'); sizesBox.scrollIntoView({behavior:'smooth',block:'center'});} return; }
      var v=findVariant(colorInput?colorInput.value:'', size);
      if(!v){ alert('Cette combinaison couleur / taille n\'est pas disponible.'); return; }
      if(v.available===false){ alert('Cette taille / couleur est en rupture de stock.'); return; }
      var old=btn.textContent; btn.disabled=true; btn.textContent='Ajout en cours...';
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:v.id,quantity:qty()}]})})
        .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
        .then(function(res){if(!res.ok){alert((res.d&&res.d.description)||'Ajout impossible.');btn.disabled=false;btn.textContent=old;return;}btn.disabled=false;btn.textContent=old;if(window.vyraeOpenCart){window.vyraeOpenCart();}else{window.location='/cart';}})
        .catch(function(){ alert('Erreur reseau, reessayez.'); btn.disabled=false; btn.textContent=old; });
    }; }
    Array.prototype.slice.call(root.querySelectorAll('[data-add-cart]')).forEach(function(btn){ btn.addEventListener('click', handler(btn)); });
  })();



(function(){var root=document.getElementById('vyrae-app');if(!root)return;var ov=root.querySelector('[data-vcart-ov]'),panel=root.querySelector('[data-vcart]');if(!panel)return;var itemsEl=root.querySelector('[data-vcart-items]'),emptyEl=root.querySelector('[data-vcart-empty]'),subEl=root.querySelector('[data-vcart-subtotal]');var totEls=root.querySelectorAll('[data-vcart-total]'),countEls=root.querySelectorAll('[data-vcart-count]'),bubbleEls=document.querySelectorAll('[data-cart-count]'),clockEl=root.querySelector('[data-vcart-clock]');function money(c,cur){try{return new Intl.NumberFormat('fr-FR',{style:'currency',currency:cur||'EUR'}).format((c||0)/100);}catch(e){return ((c||0)/100).toFixed(2)+' \u20ac';}}function esc(t){return (t||'').replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}function render(c){var cur=c.currency||'EUR';countEls.forEach(function(e){e.textContent=c.item_count;});bubbleEls.forEach(function(e){e.textContent=c.item_count;e.style.display=c.item_count>0?'':'none';});if(subEl)subEl.textContent=money(c.items_subtotal_price,cur);totEls.forEach(function(e){e.textContent=money(c.total_price,cur);});if(!c.items||c.item_count===0){if(emptyEl)emptyEl.style.display='flex';if(itemsEl)itemsEl.style.display='none';return;}if(emptyEl)emptyEl.style.display='none';if(itemsEl)itemsEl.style.display='';var h='';c.items.forEach(function(it){h+='<div class="vci" data-key="'+it.key+'"><img class="vci__img" src="'+(it.image||'')+'" alt=""><div class="vci__mid"><p class="vci__name">'+esc(it.product_title)+'</p><p class="vci__opt">'+esc(it.variant_title||'')+'</p><div class="vci__qty"><button type="button" data-minus>\u2212</button><span>'+it.quantity+'</span><button type="button" data-plus>+</button></div></div><div class="vci__right"><button type="button" class="vci__rm" data-rm aria-label="Retirer">\u2715</button><span class="vci__price">'+money(it.final_line_price,cur)+'</span></div></div>';});itemsEl.innerHTML=h;}function refresh(open){fetch('/cart.js').then(function(r){return r.json();}).then(function(c){render(c);if(open)doOpen();}).catch(function(){});}function doOpen(){ov.classList.add('is-open');panel.classList.add('is-open');panel.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';startTimer();}function doClose(){ov.classList.remove('is-open');panel.classList.remove('is-open');panel.setAttribute('aria-hidden','true');document.body.style.overflow='';}function change(k,q){fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:k,quantity:q})}).then(function(r){return r.json();}).then(function(c){render(c);}).catch(function(){});}if(ov)ov.addEventListener('click',doClose);var cb=root.querySelector('[data-vcart-close]');if(cb)cb.addEventListener('click',doClose);root.querySelectorAll('[data-open-cart]').forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();refresh(true);});});if(itemsEl)itemsEl.addEventListener('click',function(e){var row=e.target.closest('.vci');if(!row)return;var k=row.getAttribute('data-key');var sp=row.querySelector('.vci__qty span');var q=parseInt(sp?sp.textContent:'1',10);if(e.target.closest('[data-plus]'))change(k,q+1);else if(e.target.closest('[data-minus]'))change(k,Math.max(0,q-1));else if(e.target.closest('[data-rm]'))change(k,0);});var TKEY='vyrae_cart_deadline',timerInt=null;function startTimer(){if(!clockEl)return;var dl=parseInt(sessionStorage.getItem(TKEY)||'0',10);var now=Date.now();if(!dl||dl<now){dl=now+600000;sessionStorage.setItem(TKEY,dl);}if(timerInt)clearInterval(timerInt);function upd(){var ms=dl-Date.now();if(ms<0)ms=0;var m=Math.floor(ms/60000),s=Math.floor((ms%60000)/1000);clockEl.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;if(ms<=0){if(timerInt)clearInterval(timerInt);sessionStorage.removeItem(TKEY);fetch('/cart/clear.js',{method:'POST'}).then(function(){refresh(false);}).catch(function(){});}}upd();timerInt=setInterval(upd,1000);}window.vyraeOpenCart=function(){refresh(true);};refresh(false);})();
</script>
