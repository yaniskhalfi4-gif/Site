<script>
(function(){
  var RESA = 5 * 60;                          // 5 minutes de réservation
  var cart = document.getElementById('cart'), ov = document.getElementById('cartOv');
  var line = document.getElementById('cartLine'), empty = document.getElementById('cartEmpty');
  var timerEl = document.getElementById('cartTimer'), resa = document.getElementById('cartResa');
  var qty = 1, unit = 0, unitStrike = 0, left = RESA, tick = null;

  function eur(n){ return n.toFixed(2).replace('.', ',') + ' \u20AC'; }
  function num(txt){ return parseFloat(String(txt).replace(/[^0-9,]/g,'').replace(',', '.')) || 0; }
  function mmss(s){ var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }

  function render(){
    document.getElementById('clQty').textContent = qty;
    document.getElementById('clPrice').textContent  = eur(unit * qty);
    document.getElementById('clStrike').textContent = eur(unitStrike * qty);
    document.getElementById('cartTotal').textContent  = eur(unit * qty);
    document.getElementById('cartStrike').textContent = eur(unitStrike * qty);
    var eco = unitStrike > 0 ? Math.round((1 - unit/unitStrike) * 100) : 0;
    document.getElementById('cartEco').textContent = 'Économisez ' + eco + ' %';
    document.getElementById('cartCount').textContent = qty;
  }

  function stop(){ if (tick) { clearInterval(tick); tick = null; } }

  function reset(){                           // minuteur écoulé ou article retiré : tout repart à zéro
    stop();
    qty = 1; unit = 0; unitStrike = 0; left = RESA;
    line.hidden = true; empty.hidden = false;
    resa.style.display = 'none';
    document.querySelector('.cart-ship').style.display = 'none';
    document.getElementById('cartEco').style.display = 'none';
    document.getElementById('cartCount').textContent = '0';
    document.getElementById('cartTotal').textContent = eur(0);
    document.getElementById('cartStrike').textContent = '';
    document.getElementById('cartEco').textContent = '';
    timerEl.textContent = mmss(RESA);
    var bar0 = document.getElementById('cartBar');
    if (bar0) { bar0.style.transition = 'none'; bar0.style.width = '0%'; bar0.offsetWidth; bar0.style.transition = ''; }
  }

  function start(){
    stop();
    left = RESA;
    resa.style.display = '';
    document.querySelector('.cart-ship').style.display = '';
    document.getElementById('cartEco').style.display = '';
    timerEl.textContent = mmss(left);
    document.getElementById('cartBar').style.width = '0%';
    tick = setInterval(function(){
      left--;
      timerEl.textContent = mmss(Math.max(left, 0));
      // le camion avance à mesure que le minuteur tourne
      document.getElementById('cartBar').style.width = (RESA - Math.max(left, 0)) / RESA * 100 + '%';
      if (left <= 0) { reset(); }             // le produit est retiré et tout revient à l'état initial
    }, 1000);
  }

  function open(){ cart.classList.add('on'); ov.classList.add('on'); cart.setAttribute('aria-hidden','false'); }
  function close(){ cart.classList.remove('on'); ov.classList.remove('on'); cart.setAttribute('aria-hidden','true'); }

  function add(){
    var b = document.querySelector('.bundle.is-on') || document.querySelector('.bundle');
    if (!b) return;
    unit = num(b.dataset.price);
    unitStrike = num(b.dataset.strike);
    qty = 1;
    document.getElementById('clVar').textContent = b.dataset.name;
    var shot = document.getElementById('mainshot');
    if (shot) document.getElementById('clImg').src = shot.src;
    empty.hidden = true; line.hidden = false;
    render(); start(); open();
  }

  document.querySelectorAll('button.btn').forEach(function(btn){
    if (/ajouter au panier/i.test(btn.textContent)) btn.addEventListener('click', add);
  });
  document.getElementById('clPlus').addEventListener('click', function(){ qty++; render(); });
  document.getElementById('clMinus').addEventListener('click', function(){
    if (qty > 1) { qty--; render(); } else { reset(); }
  });
  document.getElementById('clDel').addEventListener('click', reset);
  var icon = document.querySelector('a.cart');
  if (icon) icon.addEventListener('click', function(e){ e.preventDefault(); open(); });
  document.getElementById('cartX').addEventListener('click', close);
  ov.addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') close(); });

  reset();
})();
</script>


<script>
/* Branchement Shopify : garde le tiroir, ajoute vraiment au panier */
(function(){
  function variante(){
    var s = document.querySelector('.bundle.is-on') || document.querySelector('.bundle');
    return s ? s.getAttribute('data-variant') : null;
  }
  document.querySelectorAll('button').forEach(function(b){
    var t = b.textContent.trim().toLowerCase();
    if (t.indexOf('ajouter au panier') === 0) {
      b.addEventListener('click', function(){
        var id = variante(); if(!id) return;
        fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({items:[{id:Number(id), quantity:1}]})});
      });
    }
    if (t.indexOf('passer à la caisse') === 0) {
      b.addEventListener('click', function(){ window.location.href = '/checkout'; });
    }
  });
})();
</script>


