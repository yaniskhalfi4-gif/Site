<script>
(function(){
  var b = document.querySelectorAll('.bundle');
  var ids = ['price','strike','save','unit'];
  b.forEach(function(x){
    x.addEventListener('click', function(){
      b.forEach(function(y){ y.classList.remove('is-on'); });
      x.classList.add('is-on');
      x.querySelector('input').checked = true;
      document.getElementById('price').textContent  = x.dataset.price;
      document.getElementById('strike').textContent = x.dataset.strike;
      document.getElementById('save').textContent   = x.dataset.save;
      document.getElementById('unit').textContent   = x.dataset.unit;
      document.getElementById('sticky-price').textContent = x.dataset.price;
      document.getElementById('sticky-pack').textContent  = x.dataset.name;
    });
  });
  // offre présélectionnée depuis la page d'accueil : ?pack=1 / 3 / 6 / 9
  var want = (location.search.match(/[?&]pack=(\d+)/) || [])[1];
  if (want) {
    b.forEach(function(x){
      if (parseInt(x.dataset.name, 10) === parseInt(want, 10)) { x.click(); }
    });
  }

  var t = document.querySelectorAll('.thumbs button');
  function go(step){
    var list = Array.prototype.slice.call(t);
    var i = list.findIndex(function(x){ return x.classList.contains('on'); });
    if (i < 0) i = 0;
    list[(i + step + list.length) % list.length].click();
  }
  var prev = document.querySelector('.sarrow.prev'), next = document.querySelector('.sarrow.next');
  if (prev) prev.addEventListener('click', function(){ go(-1); });
  if (next) next.addEventListener('click', function(){ go(1); });
  document.addEventListener('keydown', function(e){
    if (e.key === 'ArrowLeft')  go(-1);
    if (e.key === 'ArrowRight') go(1);
  });
  t.forEach(function(x){
    x.addEventListener('click', function(){
      t.forEach(function(y){ y.classList.remove('on'); });
      x.classList.add('on');
      document.getElementById('mainshot').src = x.dataset.src;
    });
  });
})();
</script>
