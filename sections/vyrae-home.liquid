<script>




(function(){var root=document.getElementById('vyrae-app');if(!root)return;var ov=root.querySelector('[data-vcart-ov]'),panel=root.querySelector('[data-vcart]');if(!panel)return;var itemsEl=root.querySelector('[data-vcart-items]'),emptyEl=root.querySelector('[data-vcart-empty]'),subEl=root.querySelector('[data-vcart-subtotal]');var totEls=root.querySelectorAll('[data-vcart-total]'),countEls=root.querySelectorAll('[data-vcart-count]'),bubbleEls=document.querySelectorAll('[data-cart-count]'),clockEl=root.querySelector('[data-vcart-clock]');function money(c,cur){try{return new Intl.NumberFormat('fr-FR',{style:'currency',currency:cur||'EUR'}).format((c||0)/100);}catch(e){return ((c||0)/100).toFixed(2)+' \u20ac';}}function esc(t){return (t||'').replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}function render(c){var cur=c.currency||'EUR';countEls.forEach(function(e){e.textContent=c.item_count;});bubbleEls.forEach(function(e){e.textContent=c.item_count;e.style.display=c.item_count>0?'':'none';});if(subEl)subEl.textContent=money(c.items_subtotal_price,cur);totEls.forEach(function(e){e.textContent=money(c.total_price,cur);});if(!c.items||c.item_count===0){if(emptyEl)emptyEl.style.display='flex';if(itemsEl)itemsEl.style.display='none';return;}if(emptyEl)emptyEl.style.display='none';if(itemsEl)itemsEl.style.display='';var h='';c.items.forEach(function(it){h+='<div class="vci" data-key="'+it.key+'"><img class="vci__img" src="'+(it.image||'')+'" alt=""><div class="vci__mid"><p class="vci__name">'+esc(it.product_title)+'</p><p class="vci__opt">'+esc(it.variant_title||'')+'</p><div class="vci__qty"><button type="button" data-minus>\u2212</button><span>'+it.quantity+'</span><button type="button" data-plus>+</button></div></div><div class="vci__right"><button type="button" class="vci__rm" data-rm aria-label="Retirer">\u2715</button><span class="vci__price">'+money(it.final_line_price,cur)+'</span></div></div>';});itemsEl.innerHTML=h;}function refresh(open){fetch('/cart.js').then(function(r){return r.json();}).then(function(c){render(c);if(open)doOpen();}).catch(function(){});}function doOpen(){ov.classList.add('is-open');panel.classList.add('is-open');panel.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';startTimer();}function doClose(){ov.classList.remove('is-open');panel.classList.remove('is-open');panel.setAttribute('aria-hidden','true');document.body.style.overflow='';}function change(k,q){fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:k,quantity:q})}).then(function(r){return r.json();}).then(function(c){render(c);}).catch(function(){});}if(ov)ov.addEventListener('click',doClose);var cb=root.querySelector('[data-vcart-close]');if(cb)cb.addEventListener('click',doClose);root.querySelectorAll('[data-open-cart]').forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();refresh(true);});});if(itemsEl)itemsEl.addEventListener('click',function(e){var row=e.target.closest('.vci');if(!row)return;var k=row.getAttribute('data-key');var sp=row.querySelector('.vci__qty span');var q=parseInt(sp?sp.textContent:'1',10);if(e.target.closest('[data-plus]'))change(k,q+1);else if(e.target.closest('[data-minus]'))change(k,Math.max(0,q-1));else if(e.target.closest('[data-rm]'))change(k,0);});var TKEY='vyrae_cart_deadline',timerInt=null;function startTimer(){if(!clockEl)return;var dl=parseInt(sessionStorage.getItem(TKEY)||'0',10);var now=Date.now();if(!dl||dl<now){dl=now+600000;sessionStorage.setItem(TKEY,dl);}if(timerInt)clearInterval(timerInt);function upd(){var ms=dl-Date.now();if(ms<0)ms=0;var m=Math.floor(ms/60000),s=Math.floor((ms%60000)/1000);clockEl.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;if(ms<=0){if(timerInt)clearInterval(timerInt);sessionStorage.removeItem(TKEY);fetch('/cart/clear.js',{method:'POST'}).then(function(){refresh(false);}).catch(function(){});}}upd();timerInt=setInterval(upd,1000);}window.vyraeOpenCart=function(){refresh(true);};refresh(false);})();
</script>
