<!-- BANDE ANNONCE (modifiable) -->
<div class="announce">-50% AUJOURD'HUI · SATISFAIT OU REMBOURSÉ 30 JOURS</div>

<!-- HEADER -->
<header class="header">
  <nav class="nav">
    <a href="#">Accueil</a>
    <a href="#produits">Le Débardeur</a>
    <a href="#contact">Contact</a>
  </nav>
  <a href="/" class="logo"><img class="brand-logo" src="{{ 'vyrae-logo.png' | file_url }}" alt="Vyrae" width="183" height="30"></a>
  <div class="header__right">
    <button type="button" class="vyrae-cart" data-open-cart aria-label="Voir le panier"><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 8h11l-.95 10.2A2 2 0 0 1 14.56 20H9.44a2 2 0 0 1-1.99-1.8L6.5 8z"/><path d="M9 8V6.6a3 3 0 0 1 6 0V8"/></svg><span class="vyrae-cart__count" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span></button>
  </div>
</header>

<!-- HERO BANNIÈRE (style Lynae) -->
<section class="hero2">
  
  <div class="wrap hero2__grid">
    <div class="hero2__text">
      <div class="stars">★★★★★ <span>4,8/5 · +883 clients satisfaits</span></div>
      <h1 class="hero2__title">Le débardeur qui redessine votre silhouette, en toute discrétion</h1>
      <p class="hero2__sub">Vyrae gaine le ventre, affine la taille et redresse le dos — sous n'importe quelle tenue, sans qu'on le voie.</p>
      <p class="hero2__sign">Pensé avec des spécialistes du maintien masculin.</p>
      <a href="{{ section.settings.product_url | default: '/' }}" class="btn">DÉCOUVRIR NOTRE DÉBARDEUR DE COMPRESSION</a>
    </div>
    <div class="hero2__product"><img src="{{ 'vyrae-hero-trio.png' | file_url }}" alt="Débardeur Vyrae 3 coloris" loading="lazy" decoding="async" width="760" height="605"></div>
  </div>
</section>

<!-- PRODUIT UNIQUE -->
<section class="section" id="produits">
  <div class="wrap">
    <h2 class="h2" style="font-family:'Syne',sans-serif;letter-spacing:.04em;color:var(--c-primary-dark)">LE DÉBARDEUR VYRAE</h2>
    <div class="solo">
      <a href="{{ section.settings.product_url | default: '/' }}" class="solo__img"><img src="{{ 'vyrae-home-product.jpg' | file_url }}" alt="Débardeur Vyrae" loading="lazy" decoding="async" width="1240" height="1240"></a>
      <div class="solo__info">
        <span class="solo__badge">2+1 OFFERT</span>
        <span class="solo__stars">★★★★★ <small>4,8/5 · +883 avis</small></span>
        <h3 class="solo__name">Débardeur de Compression Gainant</h3>
